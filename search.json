---
layout: null
---
[
  {% assign all_items = site.writeups | concat: site.projects | concat: site.notes %}
  {% for item in all_items %}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "type": {{ item.collection | jsonify }},
    "date": {{ item.date | date: "%b %-d, %Y" | jsonify }},
    "tags": {{ item.tags | jsonify }},
    "excerpt": {{ item.content | strip_html | strip_newlines | truncate: 220 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
